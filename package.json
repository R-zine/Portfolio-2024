{
  "name": "portfolio-2024",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "src/components/Angular/ContactComponent"
  ],
  "scripts": {
    "postinstall": "husky",
    "dev": "yarn build:angular && yarn dev:site",
    "dev:site": "astro dev",
    "start": "yarn dev",
    "build": "yarn build:angular && astro build",
    "build:site": "astro build",
    "build:angular": "yarn workspace contact-component build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "astro sync && astro-check && yarn workspace contact-component typecheck",
    "quality": "yarn lint && yarn typecheck",
    "test": "yarn test:unit && yarn test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "yarn build:angular && playwright test",
    "validate": "yarn quality && yarn test",
    "precommit": "yarn validate",
    "build:netlify": "yarn build"
  },
  "dependencies": {
    "@astrojs/netlify": "^3.1.1",
    "@astrojs/react": "^3.0.3",
    "@astrojs/svelte": "^4.0.3",
    "@astrojs/vue": "^3.0.1",
    "@react-three/drei": "^9.88.9",
    "@react-three/fiber": "^8.15.9",
    "@react-three/postprocessing": "^2.15.11",
    "@types/react": "^18.2.28",
    "@types/react-dom": "^18.2.13",
    "astro": "^3.3.1",
    "astro-htmx": "^1.0.3",
    "gsap": "^3.12.4",
    "htmx.org": "^1.9.9",
    "leva": "^0.9.35",
    "postprocessing": "^6.33.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "svelte": "^4.2.1",
    "svelte-inview": "^4.0.2",
    "three": "^0.158.0",
    "vue": "^3.3.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.55.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-svelte": "3.23.0",
    "eslint-plugin-vue": "10.11.0",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "typescript": "~5.2.2",
    "typescript-eslint": "8.70.0",
    "vitest": "^1.6.1",
    "vue-eslint-parser": "10.4.1"
  }
}
