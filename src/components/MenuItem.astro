---
import { colors } from "../styles/colors";

interface Props {
  title: string;
  route?: string;
  isActive: boolean;
}

const { title, route, isActive } = Astro.props;
---

<li>
  <a
    href={route}
    data-astro-prefetch
    class={isActive ? "active button" : "button"}
    aria-current={isActive ? "page" : undefined}
  >
    <span class="before" aria-hidden="true">/</span>
    <span class="label">
      {title}
    </span>
  </a>
</li>
<style define:vars={{ grey: colors.grey }}>
  a {
    text-decoration: none;
    display: flex;
    gap: 12px;
    align-items: baseline;
    transition: margin-left 300ms ease;
  }

  .active {
    pointer-events: none;
    cursor: none;
    margin-left: 10px;
    .label {
      animation: menu-label-glow 700ms cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .before {
      animation: menu-marker-reveal 600ms ease-out both;

      &::after {
        animation: menu-line-reveal 500ms ease-out both;
      }
    }
  }

  li {
    list-style-type: none;
  }

  a:hover,
  a:active {
    margin-left: 10px;

    .before {
      color: white;
      text-shadow: -10px 0 white;

      &::after {
        opacity: 1;
        transform: scaleX(1);
      }
    }

    .label {
      color: white;
      text-shadow:
        0 0 2px white,
        0 0 6px rgb(255 255 255 / 80%),
        0 0 13px rgb(255 255 255 / 55%);
    }
  }

  .before {
    position: relative;
    display: inline-block;
    text-shadow: 0 0 #ffffff;
    transition:
      color 300ms ease,
      text-shadow 300ms ease;

    &::after {
      content: "";
      position: absolute;
      bottom: -2px;
      left: -10px;
      width: 30px;
      height: 2px;
      background: white;
      opacity: 0;
      transform: scaleX(0);
      transform-origin: left;
      transition:
        opacity 300ms ease,
        transform 300ms ease;
    }
  }

  span {
    color: var(--grey);
    margin: 0;
    font-size: 1.2rem;
    transition:
      color 600ms cubic-bezier(0.22, 1, 0.36, 1),
      text-shadow 600ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes menu-label-glow {
    from {
      color: var(--grey);
      text-shadow: 0 0 transparent;
    }

    to {
      color: white;
      text-shadow:
        0 0 2px white,
        0 0 6px rgb(255 255 255 / 80%),
        0 0 13px rgb(255 255 255 / 55%);
    }
  }

  @keyframes menu-marker-reveal {
    from {
      color: var(--grey);
      text-shadow: 0 0 transparent;
    }

    to {
      color: white;
      text-shadow: -10px 0 white;
    }
  }

  @keyframes menu-line-reveal {
    from {
      opacity: 0;
      transform: scaleX(0);
    }

    to {
      opacity: 1;
      transform: scaleX(1);
    }
  }
</style>
