---
import { getPageInformation } from "../utils/routes";

const message = getPageInformation(Astro.url.searchParams.get("page"));
---

<div id="info-cont" style="pointer-events: auto;">
  <div class="info-shown">
    <section
      role="dialog"
      aria-modal="true"
      aria-labelledby="page-information-title"
      style="width: 80%; height: 80%; border: 2px solid white; border-radius: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center;"
    >
      <div
        style="display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; font-size: 24px; padding: 20%"
      >
        <h2 id="page-information-title" class="sr-only">About this page</h2>
        <p>{message}</p>
        <button
          type="button"
          class="info-box-btn button"
          aria-label="Close page information"
          hx-get="/remove-info"
          hx-target="#info-cont"
          hx-swap="outerHTML swap:360ms settle:30ms"
        >
          <svg
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            height="16"
            width="12"
            viewBox="0 0 384 512"
            ><!--!Font Awesome Free 6.5.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2023 Fonticons, Inc.-->
            <path
              d="M342.6 150.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L192 210.7 86.6 105.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L146.7 256 41.4 361.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0L192 301.3 297.4 406.6c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L237.3 256 342.6 150.6z"
            ></path></svg
          >
        </button>
      </div>
    </section>
  </div>
</div>
